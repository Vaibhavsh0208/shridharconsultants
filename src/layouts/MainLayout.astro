---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import FloatingButtons from "../components/FloatingButtons.astro";
import { site } from "../config/site";
import { getContent, otherLang, localePath, stripLang, languages } from "../i18n";
import type { Lang } from "../i18n";

interface Props {
  title: string;
  description: string;
  lang: Lang;
  crumb?: string; // name of this page in the breadcrumb trail (not set on the home page)
  noindex?: boolean; // for pages that must stay out of search results (the 404 page)
}

const { title, description, lang, crumb, noindex = false } = Astro.props;
const t = getContent(lang);

// The same page in each language, e.g. /about/ and /hi/about/
const enPath = stripLang(Astro.url.pathname);
const urlFor = (l: Lang) => site.url + localePath(enPath, l);
// A page with no counterpart (the 404 page) sends the language toggle to the other home page
const switchHref = noindex ? localePath("/", otherLang(lang)) : localePath(enPath, otherLang(lang));

const businessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": `${site.url}/#business`,
  name: site.name,
  url: `${site.url}/`,
  logo: site.url + site.logo,
  image: site.url + site.logo,
  telephone: site.phone.tel,
  description: site.description,
  foundingDate: site.foundingYear,
  knowsAbout: site.knowsAbout,
  sameAs: [site.mapsUrl],
  openingHoursSpecification: {
    "@type": "OpeningHoursSpecification",
    dayOfWeek: site.hours.days,
    opens: site.hours.opens,
    closes: site.hours.closes,
  },
  contactPoint: {
    "@type": "ContactPoint",
    telephone: site.phone.tel,
    contactType: "customer service",
    areaServed: "IN",
    availableLanguage: ["English", "Hindi"],
  },
  address: {
    "@type": "PostalAddress",
    streetAddress: site.address.street,
    addressLocality: site.address.city,
    addressRegion: site.address.region,
    postalCode: site.address.postalCode,
    addressCountry: site.address.country,
  },
  areaServed: [
    { "@type": "State", name: "Haryana" },
    { "@type": "State", name: "Punjab" },
    { "@type": "AdministrativeArea", name: "Delhi NCR" },
    ...site.cities.map((name) => ({ "@type": "City", name })),
  ],
  geo: {
    "@type": "GeoCoordinates",
    latitude: site.geo.lat,
    longitude: site.geo.lng,
  },
};

// Home > this page, so search results can show where the page sits
const breadcrumbSchema = crumb
  ? {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: t.nav.home, item: site.url + localePath("/", lang) },
        { "@type": "ListItem", position: 2, name: crumb, item: urlFor(lang) },
      ],
    }
  : null;

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  serviceType: "NHAI NOC Consultancy",
  provider: { "@id": `${site.url}/#business` },
  areaServed: site.areaServed,
  // The services listed on the Services page, in this page's language
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: t.services.title,
    itemListElement: t.services.fullList.map((name) => ({
      "@type": "Offer",
      itemOffered: { "@type": "Service", name },
    })),
  },
};

// Home pages only: tells search engines the site's name and that the business publishes it
const websiteSchema = crumb || noindex
  ? null
  : {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "@id": `${site.url}/#website`,
      url: `${site.url}/`,
      name: site.name,
      inLanguage: t.htmlLang,
      publisher: { "@id": `${site.url}/#business` },
    };
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content={noindex ? "noindex" : "index, follow"} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- One canonical URL per language, and each version points at the other -->
    {!noindex && <link rel="canonical" href={urlFor(lang)} />}
    {!noindex && languages.map((l) => <link rel="alternate" hreflang={l} href={urlFor(l)} />)}
    {!noindex && <link rel="alternate" hreflang="x-default" href={urlFor("en")} />}

    <!-- Open Graph / Twitter -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={site.url + site.logo} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="512" />
    <meta property="og:image:height" content="512" />
    <meta property="og:image:alt" content={site.name} />
    <meta property="og:locale" content={t.ogLocale} />
    {!noindex && <meta property="og:url" content={urlFor(lang)} />}
    <meta property="og:site_name" content={site.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={site.url + site.logo} />

    <!-- Geo -->
    <meta name="geo.country" content="IN" />
    <meta name="geo.region" content="IN-HR" />
    <meta name="geo.placename" content={site.address.city} />
    <meta name="geo.position" content={`${site.geo.lat};${site.geo.lng}`} />
    <meta name="ICBM" content={`${site.geo.lat}, ${site.geo.lng}`} />

    <link rel="icon" href={site.favicon} type="image/png" />
    <link rel="apple-touch-icon" href={site.appleIcon} />
    <link rel="preload" as="image" href={site.logoSvg} />

    <!-- Structured data shared by every page -->
    <script type="application/ld+json" set:html={JSON.stringify(businessSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
    {breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}
    {websiteSchema && <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />}

    <slot name="head" />
  </head>

  <body>
    <Header lang={lang} switchHref={switchHref} />
    <Navbar lang={lang} />

    <main>
      <slot />
    </main>

    <FloatingButtons lang={lang} />
    <Footer lang={lang} />
  </body>
</html>
