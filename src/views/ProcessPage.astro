---
import MainLayout from "../layouts/MainLayout.astro";
import BackLink from "../components/BackLink.astro";
import ProcessSection from "../components/sections/ProcessSection.astro";
import ContactSection from "../components/sections/ContactSection.astro";
import { getContent } from "../i18n";
import type { Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getContent(lang);
const { title, description } = t.meta.process;
---

<MainLayout title={title} description={description} lang={lang} crumb={t.nav.process}>
  <BackLink lang={lang} section="process" />
  <ProcessSection lang={lang} mode="full" />
  <ContactSection lang={lang} />
</MainLayout>
