---
import MainLayout from "../layouts/MainLayout.astro";
import BackLink from "../components/BackLink.astro";
import AccessPermissionSection from "../components/sections/AccessPermissionSection.astro";
import ContactSection from "../components/sections/ContactSection.astro";
import { getContent } from "../i18n";
import type { Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getContent(lang);
const { title, description } = t.meta.accessPermission;
---

<MainLayout title={title} description={description} lang={lang} crumb={t.nav.accessPermission}>
  <BackLink lang={lang} section="access-permission" />
  <AccessPermissionSection lang={lang} mode="full" />
  <ContactSection lang={lang} />
</MainLayout>
