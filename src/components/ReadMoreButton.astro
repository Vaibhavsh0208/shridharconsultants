---
// 1. Centralized dictionary for all button text variants
const TEXT_VARIANTS = {
  read: { en: "Read More", hi: "और पढ़ें" },
  view: { en: "View More", hi: "और देखें" },
  process: { en: "View Full Process", hi: "पूरी प्रक्रिया देखें" },
  services: { en: "View All Services", hi: "सभी सेवाएँ देखें" },
};

// 2. Define the 'Props' interface to satisfy TypeScript
interface Props {
  href: string;
  type?: keyof typeof TEXT_VARIANTS; // This tells VS Code: "Only keys from TEXT_VARIANTS are allowed"
}

const { href, type = "read" } = Astro.props;

// 3. Pick the labels based on the type provided
const label = TEXT_VARIANTS[type] || TEXT_VARIANTS.read;
---

<a href={href} class="read-more-btn">
  <span class="en">{label.en}</span>
  <span class="hi hidden">{label.hi}</span>
</a>

<style>
  .read-more-btn {
    background: #0b3d6b;
    color: white;
    padding: 10px 16px;
    border-radius: 6px;
    display: inline-block;
    text-decoration: none;
    font-size: 15px;
    font-weight: 600;
    transition:
      background 0.2s ease,
      transform 0.1s ease;
  }

  .read-more-btn:hover {
    background: #082c4d;
  }

  .read-more-btn:active {
    transform: scale(0.96);
  }
</style>
