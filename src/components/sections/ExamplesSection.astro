---
import ArrowLink from "../ArrowLink.astro";
import { Image, getImage } from "astro:assets";
import Lightbox from "../Lightbox.astro";
import layoutPlan from "../../assets/images/nhai-petrol-pump-layout-plan.png";
import privateAccess from "../../assets/images/nhai-highway-access-private-property.jpg";
import culvert from "../../assets/images/nhai-access-rcc-slab-culvert.jpg";
import { getContent, localePath } from "../../i18n";
import type { Lang } from "../../i18n";

interface Props {
  lang: Lang;
  mode?: "summary" | "full";
}

const { lang, mode = "summary" } = Astro.props;
const t = getContent(lang);
const isFull = mode === "full";
// On the full pages the section title is the page's main heading (h1)
const Heading = isFull ? "h1" : "h2";

// Photos are language-independent; alt text and captions come from the content files.
// `full` is a big WebP copy for the lightbox, so zooming stays sharp.
const photos = [layoutPlan, privateAccess, culvert];
const examples = await Promise.all(
  t.examples.items.map(async (item, i) => ({
    ...item,
    src: photos[i],
    full: (await getImage({ src: photos[i], format: "webp", quality: 85 })).src,
  })),
);
const shown = isFull ? examples : examples.slice(0, 2);
---

<section id={isFull ? undefined : "examples"} class="examples">
  <div class="container">
    <Heading class="section-title">{t.examples.title}</Heading>
    <p>{t.examples.intro}</p>

    <div class="examples-grid">
      {
        shown.map((item) => (
          <div class="card">
            <button type="button" class="thumb" data-lightbox data-full={item.full}>
              <Image
                src={item.src}
                alt={item.alt}
                widths={[400, 800]}
                sizes="(max-width: 768px) 92vw, 440px"
                format="webp"
                loading="lazy"
              />
            </button>
            <p>{item.caption}</p>
          </div>
        ))
      }
    </div>

    {!isFull && <ArrowLink href={localePath("/examples", lang)} label={t.examples.viewMore} />}
  </div>

  <Lightbox label={t.ui.lightboxAlt} closeLabel={t.ui.closeLabel} />
</section>

<style>
  .examples-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 12px;
    margin: 10px 0 20px 0;
  }

  .card {
    background: var(--color-bg);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-card);
    padding: 5px;
  }

  .thumb {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    cursor: zoom-in;
  }

  .card img {
    display: block;
    width: 100%;
    height: 160px;
    object-fit: cover;
    border-radius: var(--radius-md);
    cursor: zoom-in;
    transition: transform 0.2s ease;
  }

  .card img:hover {
    transform: scale(1.03);
  }

  .card p {
    padding: 12px 14px 16px 14px;
    margin: 0;
  }
</style>
