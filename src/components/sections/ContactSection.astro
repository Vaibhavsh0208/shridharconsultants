---
import { site } from "../../config/site";
import { getContent } from "../../i18n";
import type { Lang } from "../../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getContent(lang);
---

<section id="contact" class="contact">
  <div class="container">
    <h2>{t.contact.title}</h2>

    <p><strong>{t.contact.proprietor}</strong> {site.proprietor}</p>

    <p>
      <strong>{t.contact.call}</strong>{" "}
      <a href={`tel:${site.phone.tel}`}>{site.phone.display}</a>
    </p>

    <p>
      <strong>{t.contact.whatsapp}</strong>{" "}
      <a href={site.whatsapp.url} target="_blank" rel="noopener noreferrer">{site.whatsapp.display}</a>
    </p>

    <p>
      <strong>{t.contact.address}</strong>{" "}
      {site.address.display}
      <br />
      <strong>{t.contact.maps}</strong>{" "}
      <a href={site.mapsUrl} target="_blank" rel="noopener noreferrer">{site.name}</a>
    </p>

    <p><strong>{t.contact.hours}</strong> {t.contact.hoursValue}</p>
  </div>
</section>

<style>
  p {
    text-align: justify;
  }

  a {
    color: var(--color-primary);
    text-decoration: none;
    font-weight: 700;
  }
</style>
