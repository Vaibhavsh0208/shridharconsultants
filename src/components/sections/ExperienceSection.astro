---
import { getContent } from "../../i18n";
import type { Lang } from "../../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getContent(lang);
---

<section id="experience" class="experience">
  <div class="container">
    <h2>{t.experience.title}</h2>
    <p>{t.experience.text}</p>
  </div>
</section>

<style>
  p {
    text-align: justify;
  }
</style>
